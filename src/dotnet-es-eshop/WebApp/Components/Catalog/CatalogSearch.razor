@inject NavigationManager Nav

@if (Brands is not null && Types is not null)
{
    <aside class="catalog-search">
        <details class="catalog-search-details" open>
            <summary class="catalog-search-summary">
                <span class="catalog-search-title">
                    <img role="presentation" src="icons/filters.svg" />
                    Filters
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="catalog-search-title-count">@ActiveFilterCount</span>
                    }
                </span>
            </summary>

            <div class="catalog-search-body">
                @if (HasActiveFilter)
                {
                    <a class="catalog-search-clear" href="@ResetUri()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                        Clear all filters
                    </a>
                }

                <div class="catalog-search-group">
                    <h3>Brand</h3>
                    <div class="catalog-search-group-tags">
                        <a href="@BrandUri(null)"
                           class="catalog-search-tag @(BrandActiveCount == 0 ? "active" : "")">
                            <span>All</span>
                            <span class="catalog-search-tag-count">@BrandCount(null)</span>
                        </a>
                        @foreach (var brand in Brands)
                        {
                            var count = BrandCount(brand.BrandId);
                            var isActive = IsBrandActive(brand.BrandId);
                            var isEmpty = count == 0 && !isActive;
                            <a href="@BrandUri(brand.BrandId)"
                               class="catalog-search-tag @(isActive ? "active" : "") @(isEmpty ? "is-empty" : "")"
                               aria-disabled="@(isEmpty ? "true" : null)">
                                <span>@brand.Name</span>
                                <span class="catalog-search-tag-count">@count</span>
                            </a>
                        }
                    </div>
                </div>
                <div class="catalog-search-group">
                    <h3>Type</h3>
                    <div class="catalog-search-group-tags">
                        <a href="@TypeUri(null)"
                           class="catalog-search-tag @(TypeActiveCount == 0 ? "active" : "")">
                            <span>All</span>
                            <span class="catalog-search-tag-count">@TypeCount(null)</span>
                        </a>
                        @foreach (var itemType in Types)
                        {
                            var count = TypeCount(itemType.TypeId);
                            var isActive = IsTypeActive(itemType.TypeId);
                            var isEmpty = count == 0 && !isActive;
                            <a href="@TypeUri(itemType.TypeId)"
                               class="catalog-search-tag @(isActive ? "active" : "") @(isEmpty ? "is-empty" : "")"
                               aria-disabled="@(isEmpty ? "true" : null)">
                                <span>@itemType.Name</span>
                                <span class="catalog-search-tag-count">@count</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </details>
    </aside>
}

@code {
    [Parameter] public IReadOnlyList<CatalogBrandName>? Brands { get; set; }
    [Parameter] public IReadOnlyList<CatalogTypeName>? Types { get; set; }
    [Parameter] public IReadOnlyList<BrowseCatalogFacet>? BrandFacets { get; set; }
    [Parameter] public IReadOnlyList<BrowseCatalogFacet>? TypeFacets { get; set; }
    [Parameter] public Guid[]? BrandIds { get; set; }
    [Parameter] public Guid[]? TypeIds { get; set; }

    private IReadOnlyList<Guid> SelectedBrands => BrandIds ?? [];
    private IReadOnlyList<Guid> SelectedTypes => TypeIds ?? [];

    private int BrandActiveCount => SelectedBrands.Count;
    private int TypeActiveCount => SelectedTypes.Count;

    bool HasActiveFilter => SelectedBrands.Count > 0 || SelectedTypes.Count > 0;
    int ActiveFilterCount => SelectedBrands.Count + SelectedTypes.Count;

    private bool IsBrandActive(Guid id) => SelectedBrands.Contains(id);
    private bool IsTypeActive(Guid id) => SelectedTypes.Contains(id);

    // Within a facet, selections are additive. Across facets they intersect.
    // A brand option is counted against the active type set. A type option is counted
    // against the active brand set. A facet that is absent from the response has no
    // matching items (count 0). The All count is the sum of that facet's counts.
    private int BrandCount(Guid? brandId) => FacetCount(BrandFacets, brandId);

    private int TypeCount(Guid? typeId) => FacetCount(TypeFacets, typeId);

    private static int FacetCount(IReadOnlyList<BrowseCatalogFacet>? facets, Guid? id)
    {
        if (facets is null)
            return 0;

        if (id is null)
        {
            var total = 0;
            foreach (var facet in facets)
                total += facet.Count;
            return total;
        }

        foreach (var facet in facets)
        {
            if (facet.Id == id)
                return facet.Count;
        }

        return 0;
    }

    private string BrandUri(Guid? brandId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", ToggleValue(SelectedBrands, brandId) },
    });

    private string TypeUri(Guid? typeId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "type", ToggleValue(SelectedTypes, typeId) },
    });

    private string ResetUri() => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", null },
        { "type", null },
    });

    private static Guid[]? ToggleValue(IReadOnlyList<Guid> current, Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return null;

        Guid[] next = current.Contains(id.Value)
            ? current.Where(value => value != id.Value).ToArray()
            : [.. current, id.Value];

        return next.Length == 0 ? null : next;
    }
}
