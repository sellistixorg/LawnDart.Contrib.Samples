<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>LawnDart.Samples.EShop.WebApp</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LawnDart" />
    <PackageReference Include="LawnDart.AspNetCore" />
    <PackageReference Include="LawnDart.EventSourcing" />
    <PackageReference Include="LawnDart.Messaging" />
    <PackageReference Include="LawnDart.Messaging.InMemory" />
    <PackageReference Include="LawnDart.Projections.Lightweight" />
  </ItemGroup>
  <ItemGroup>
    <!-- Parked assistant files stay on disk. They are not project items, so their styles and scripts are not part of the app. -->
    <Compile Remove="Components/Chatbot/**/*.cs" />
    <Content Remove="Components/Chatbot/**" />
    <None Remove="Components/Chatbot/**" />
    <Content Remove="wwwroot/js/chat-dock.js;wwwroot/js/chat-eyes.js;wwwroot/js/chat-fab.js;wwwroot/chat.png;wwwroot/chatbot.png" />
    <None Remove="wwwroot/js/chat-dock.js;wwwroot/js/chat-eyes.js;wwwroot/js/chat-fab.js;wwwroot/chat.png;wwwroot/chatbot.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceDefaults\LawnDart.Samples.EShop.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Shared\LawnDart.Samples.EShop.Shared.csproj" />
    <ProjectReference Include="..\Infrastructure\LawnDart.Samples.EShop.Infrastructure.csproj" />
  </ItemGroup>
</Project>
